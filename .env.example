# Local development only. In AWS the *_PARAM variables point to SSM SecureString parameters instead.
TMDB_API_KEY=
# TMDB_READ_TOKEN=          # alternative to TMDB_API_KEY (v4 bearer token)
MDBLIST_API_KEY=

# Optional overrides (defaults shown)
# PROVIDERS=netflix,hbo,prime
# REGION=BR
# WINDOW_DAYS=14                 # first window; widened until TOP_N series qualify
# WINDOW_STEPS_DAYS=14,21,30,45,60,90,180,365
# TOP_N=20
# MIN_VOTE=6.0
# MIN_VOTE_COUNT=0
# EXCLUDED_TERMS=chicago,lei & ordem,law & order,ncis
# EXCLUDED_GENRES=10764
# SAFETY_MIN_SELECTED=5
# SERIES_LIST_NAME=StreammySeries
# IMDB_RATINGS=true              # IMDb first, TMDB as fallback
# IMDB_CACHE_DIR=/tmp/streaming-top-series-imdb
# MOVIES_LIST_NAME=StreammyMovies
# MOVIES_TOP_N=20
# MOVIES_MIN_SCORE=5.0
# MOVIES_EXCLUDED_GENRES=35
# MOVIES_WINDOW_STEPS_DAYS=30,60,120,240,365
# SNAPSHOT_DIR=./snapshots
# DRY_RUN=false
